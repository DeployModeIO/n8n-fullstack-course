# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Auth ---
# Secret used to sign the session JWT. Falls back to SUPABASE_SERVICE_ROLE_KEY.
AUTH_SECRET=generate-a-long-random-string
# Optional: set the cookie domain explicitly in production (e.g. .example.com)
AUTH_COOKIE_DOMAIN=

# --- Certificates (optional: local | sertifier | accredible) ---
CERT_PROVIDER=local
SERTIFIER_SECRET_KEY=
SERTIFIER_DESIGN_ID=
ACCREDIBLE_API_KEY=
ACCREDIBLE_GROUP_ID=
